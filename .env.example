# .env.example — placeholder values ONLY (SEC-SECRETS-02).
# Copy to .env (gitignored) and fill in real values.
# Each variable: NAME=            # where to get the value
#
# obsidian-brain holds no credentials. Its only setting is the vault root, which is
# passed as an env var in the Claude Desktop / Claude Code MCP server config rather
# than read from a dotenv file — the server never loads .env itself.

OBSIDIAN_VAULT_ROOT=            # absolute path to the vault; defaults to ~/Documents/Obsidian/Personal
